APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
GUILD_ID=

# schizo thread mode and message context menu defaults, 1-3 comma-separated boards
SCHIZO_BOARDS=g
# older single-board setting also works when SCHIZO_BOARDS is empty or unset
# SCHIZO_BOARD=g

# OpenAI-compatible chat completions (OpenAI, OpenRouter, Ollama, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
